{
  "name": "habits-manager",
  "version": "0.1.0",
  "description": "Gestionnaire de tâches et habitudes gamifié pour Home Assistant",
  "main": "dist/kids-tasks-card.js",
  "type": "module",
  "scripts": {
    "build": "rollup -c --environment NODE_ENV:production",
    "build:dev": "rollup -c --environment NODE_ENV:development",
    "dev": "rollup -c -w --environment NODE_ENV:development",
    "serve": "npx live-server --port=8080 --cors --watch=dist,../../custom_components/habits_manager/www --open=false --no-browser",
    "dev:full": "npx concurrently \"npm run dev\" \"npm run serve\"",
    "watch": "npm run dev",
    "clean": "rm -rf dist",
    "lint": "eslint src --ext .js",
    "format": "prettier --write \"src/**/*.js\""
  },
  "keywords": [
    "home-assistant",
    "custom-card",
    "habits",
    "tasks",
    "gamification"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@rollup/plugin-commonjs": "^25.0.7",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^15.2.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^11.1.6",
    "@typescript-eslint/eslint-plugin": "^6.21.0",
    "@typescript-eslint/parser": "^6.21.0",
    "concurrently": "^9.2.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-lit": "^1.11.0",
    "live-server": "^1.2.2",
    "prettier": "^3.2.5",
    "rollup": "^4.9.6",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.6.2",
    "typescript": "^5.3.3"
  }
}
