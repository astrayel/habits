{
  "name": "habits-manager",
  "version": "0.1.0",
  "description": "Gestionnaire de tâches et habitudes gamifié pour Home Assistant",
  "main": "dist/habits-manager.js",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write \"src/**/*.ts\""
